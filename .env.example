# ==============================================================================
# Environment Configuration Template (.env.example)
#
# Copy this file to '.env' and fill in the values as needed:
#   cp .env.example .env (or 'copy .env.example .env' in Windows Command Prompt)
#
# NOTE: Never commit your actual '.env' file or real credentials to version control.
# ==============================================================================

# Application environment (e.g., development, staging, production)
ENVIRONMENT=development

# Logging configuration (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Data Collection Settings
# Default country store for app reviews (e.g., 'in' for India)
APP_STORE_COUNTRY=in
# Maximum number of reviews to collect per source/platform during testing
MAX_REVIEWS_TO_FETCH=100

# AI / LLM Configuration
# LLM Provider options: 'gemini', 'openai', or 'mock' (leave blank for automatic detection or offline rule fallback)
LLM_PROVIDER=
# Model name override (defaults to 'gemini-1.5-flash' for Gemini, 'gpt-4o-mini' for OpenAI)
LLM_MODEL=
# API keys (Keep blank if running in offline rule-based mode)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Reddit API Credentials (Optional, if using Reddit API for community discussions)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=
