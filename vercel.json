{
  "version": 2,
  "functions": {
    "web/api/chat.js": {
      "includeFiles": "web/data/corpus.json"
    }
  },
  "rewrites": [
    { "source": "/api/chat", "destination": "/web/api/chat.js" },
    { "source": "/", "destination": "/web/index.html" },
    { "source": "/(.*)", "destination": "/web/$1" }
  ]
}

